    {
      "number": 120565351509754,
      "spelling": "zen pfor ＋ 動名詞",
      "pronunciation": "",
      "tags": [
        "動詞慣用句"
      ],
      "sections": [
        {
          "equivalents": [
            {
              "titles": [
                "動詞慣用句"
              ],
              "terms": [
                "〜する役に自ら名乗り出る、進んで〜すると申し出る"
              ],
              "termString": "〜する役に自ら名乗り出る、進んで〜すると申し出る",
              "ignoredPattern": "",
              "hidden": false
            }
          ],
          "informations": [
            {
              "title": "分類",
              "text": "動詞慣用句\n原資料：動詞慣用句",
              "hidden": false
            },
            {
              "title": "祖語・由来",
              "text": "zen「立つ」＋pfor「〜のために」。「その役目のために立ち上がる」から、自発的な申し出を表す慣用句へ",
              "hidden": false
            },
            {
              "title": "備考",
              "text": "zen は主語の人称・数・時制に応じて通常どおり活用する。名乗り出る人と動名詞の行為者は同じ。pfor は主格を支配し、動名詞自身の目的語は属格。実際に立ち上がる動作を伴わなくても使う。一人称では「私が〜しよう」という申し出、三人称ではその人自身が名乗り出ることを表す。用例は「7. 依頼・申し出・命令」を参照。2026-09-17 作者採用。",
              "hidden": false
            },
            {
              "title": "出典",
              "text": "ラフカ語辞書.md:683\nラフカ語文法.md §1.4・2.2・2.4\n状態：採用済み",
              "hidden": false
            }
          ],
          "phrases": [],
          "variations": [
            {
              "title": "構文",
              "spelling": "主語＋zen（活用）＋pfor＋動名詞（主格）",
              "pronunciation": ""
            }
          ],
          "relations": []
        }
      ]
    },
