    {
      "number": 144721553164583,
      "spelling": "šaco",
      "pronunciation": "",
      "tags": [
        "形容詞",
        "母音幹形容詞",
        "中性ウムラウト型"
      ],
      "sections": [
        {
          "equivalents": [
            {
              "titles": [
