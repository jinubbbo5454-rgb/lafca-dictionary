            },
            {
              "title": "対応",
              "text": "同語根（資料）",
              "hidden": false
            },
            {
              "title": "語幹",
              "text": "男性語幹：wostrag-\n女性語幹：wostrag-\n中性語幹：wosträg-",
              "hidden": false
            },
