    {
      "number": 92256302071950,
      "spelling": "trebüčen",
      "pronunciation": "",
      "tags": [
        "動詞",
        "非交替動詞",
        "非交替"
      ],
      "sections": [
        {
          "equivalents": [
            {
              "titles": [
                "動詞"
              ],
              "terms": [
                "織る"
              ],
              "termString": "織る",
              "ignoredPattern": "",
              "hidden": false
            }
          ],
          "informations": [
            {
              "title": "分類",
              "text": "動詞 / 非交替動詞 / 非交替\n原資料：非交替",
              "hidden": false
            },
            {
              "title": "祖語・由来",
              "text": "Ald. trebūch。ū > ü、ch > č。不定形 -en を付加",
              "hidden": false
            },
            {
              "title": "アルディア語",
              "text": "trebūch",
              "hidden": false
            },
            {
              "title": "対応",
              "text": "同",
              "hidden": false
            },
            {
              "title": "語幹",
              "text": "現在語幹：trebüč-\n語幹：trebüč-",
              "hidden": false
            },
            {
              "title": "備考",
              "text": "語幹末の母音 ü は長 ū 由来なので非交替。2026-09-16 作者採用。[アルディア語辞書 D971:F971](https://docs.google.com/spreadsheets/d/1CD-F0WyFX8-zg4wAGRbt53BmaKlAA_WWubw5ZScd6Ug/edit#gid=0&range=D971:F971)。",
              "hidden": false
            },
            {
              "title": "用法",
              "text": "アオリストは全人称同形。未来は ša ＋現在形、進行は le ＋動名詞、完了は he ＋過去分詞。",
              "hidden": false
            },
            {
              "title": "出典",
              "text": "ラフカ語辞書.md:410\nラフカ語文法.md §1.4・2.2・2.4\n状態：採用済み",
              "hidden": false
            },
